# Razorpay test credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# AgentShield Ed25519 mandate asymmetric signing keys (AP2-aligned)
# Generate with: python scripts/generate_signing_key.py
MANDATE_SIGNING_KID=key-demo-01
MANDATE_SIGNING_PRIVATE_KEY_HEX=c6ceb383f729f384a35fff3a2bff05b27d3c030e54530ad7955ab15dfb3eee2b
MANDATE_VERIFYING_KEYRING_JSON={"key-demo-01": "19683148581be5a1b4bc3679f07c0baa36c29012677e4f9de6f1ee9d08b47262"}

# [DEPRECATED - UNUSED] Legacy HMAC mandate secret key
# MANDATE_SECRET_KEY=replace-with-at-least-32-random-bytes

# Persistence/runtime
DATABASE_PATH=state.db
MANDATE_TTL_SECONDS=300
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=10

# API authentication
# Use at least 32 random characters.
AGENTSHIELD_API_TOKEN=replace-with-at-least-32-random-characters
AGENTSHIELD_API_USER_ID=user_123
AGENTSHIELD_API_AGENT_ID=agent_001
AGENTSHIELD_APPROVER_TOKEN=replace-with-at-least-32-random-approver-characters
AGENTSHIELD_APPROVAL_TTL_SECONDS=900

# Active LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Local demo mode
# Keep false for normal fail-closed operation.
AGENTSHIELD_DEMO_MODE=false